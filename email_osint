#!/usr/bin/env python3
"""
Email Validation - Check email format and MX records
"""

from mamba import MambaClient, EmailReputation

def validate_email(email_address):
    """Validate a single email address"""
    
    with MambaClient() as client:
        email = EmailReputation(client)
        result = email.validate_format(email_address)
        
        print(f"\n Email: {email_address}")
        print("-" * 40)
        
        if result.success:
            print(f"   Valid format: {result.data['valid_format']}")
            print(f"   MX records: {result.data['has_mx_records']}")
            print(f"   Domain: {result.data['domain']}")
            
            if result.data['mx_records']:
                print(f"   Mail servers: {', '.join(result.data['mx_records'][:3])}")
        else:
            print(f"   Invalid: {result.error}")
        
        return result

def validate_multiple_emails(email_list):
    """Validate multiple email addresses"""
    
    results = []
    for email in email_list:
        result = validate_email(email)
        results.append(result)
    
    return results

def main():
    emails = [
        "user@gmail.com",
        "admin@company.co.uk",
        "invalid-email",
        "test@localhost"
    ]
    
    print("=" * 60)
    print("Mamba - Email Validation Tool")
    print("=" * 60)
    
    results = validate_multiple_emails(emails)
    
    # Summary
    print("\n" + "=" * 60)
    print("SUMMARY")
    print("=" * 60)
    
    valid = [r for r in results if r.success and r.data['valid_format']]
    print(f"Valid emails: {len(valid)}/{len(emails)}")
    
    for r in valid:
        print(f"  {r.query}")

if __name__ == "__main__":
    main()
